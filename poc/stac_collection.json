{
    "type": "Collection",
    "stac_version": "1.0.0",
    "id": "nested-eagle",
    "title": "NOAA Nested-EAGLE Weather Forecasts",
    "description": "AI weather forecasts from the Nested-EAGLE model. Produces 360-hour forecasts every 6 hours by nesting a high-resolution HRRR grid (6km, CONUS) inside a global GFS grid (0.25°). Each forecast cycle produces separate global and CONUS regional files.",
    "license": "proprietary",
    "keywords": [
        "weather",
        "forecast",
        "AI",
        "NOAA",
        "EAGLE",
        "HRRR",
        "GFS",
        "CONUS",
        "global"
    ],
    "providers": [
        {
            "name": "NOAA/EPIC",
            "roles": [
                "producer"
            ],
            "url": "https://epic.noaa.gov/"
        },
        {
            "name": "Microsoft Planetary Computer",
            "roles": [
                "host"
            ],
            "url": "https://planetarycomputer.microsoft.com/"
        }
    ],
    "extent": {
        "spatial": {
            "bbox": [
                [
                    -180.0,
                    -90.0,
                    180.0,
                    90.0
                ]
            ]
        },
        "temporal": {
            "interval": [
                [
                    "2026-04-01T00:00:00Z",
                    null
                ]
            ]
        }
    },
    "summaries": {
        "nested-eagle:output_type": [
            "CONUS & Global Domains"
        ],
        "nested-eagle:variables": [
            "10m_meridional_wind",
            "10m_zonal_wind",
            "2m_specific_humidity",
            "2m_temperature",
            "80m_meridional_wind",
            "80m_zonal_wind",
            "geopotential_height",
            "meridional_wind",
            "specific_humidity",
            "surface_pressure",
            "surface_temperature",
            "temperature",
            "total_precipitation_6hr",
